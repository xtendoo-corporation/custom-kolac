<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kolac_account_import_batch_tree" model="ir.ui.view">
        <field name="name">kolac.account.import.batch.tree</field>
        <field name="model">kolac.account.import.batch</field>
        <field name="arch" type="xml">
            <list string="Lotes de importación contable">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="journal_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="move_count"/>
                <field name="line_count"/>
                <field name="warning_count"/>
                <field name="error_count"/>
                <field name="imported_at"/>
            </list>
        </field>
    </record>

    <record id="view_kolac_account_import_batch_form" model="ir.ui.view">
        <field name="name">kolac.account.import.batch.form</field>
        <field name="model">kolac.account.import.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de importación contable">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journal_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="diary_file_name"/>
                            <field name="account_list_file_name"/>
                            <field name="account_plan_file_name"/>
                            <field name="imported_at"/>
                        </group>
                    </group>
                    <group string="Resumen">
                        <field name="mapping_line_count" readonly="1"/>
                        <field name="asset_line_count" readonly="1"/>
                        <field name="warning_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                        <field name="move_count" readonly="1"/>
                        <field name="line_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Informe">
                            <field name="review_report" nolabel="1" readonly="1" widget="text"/>
                        </page>
                        <page string="Activos detectados">
                            <field name="asset_preview_line_ids" nolabel="1" readonly="1">
                                <list>
                                     <field name="source_code"/>
                                     <field name="asset_name"/>
                                     <field name="target_account_id"/>
                                     <field name="depreciation_source_code"/>
                                     <field name="depreciation_target_account_id"/>
                                     <field name="original_value"/>
                                     <field name="accumulated_value"/>
                                     <field name="residual_value"/>
                                     <field name="state"/>
                                     <field name="acquisition_date" optional="show"/>
                                     <field name="source_reference" optional="show"/>
                                     <field name="source_label" optional="show"/>
                                     <field name="warning_message" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Trazabilidad">
                            <field name="trace_line_ids" nolabel="1" readonly="1">
                                <list>
                                     <field name="move_id"/>
                                     <field name="move_line_id"/>
                                     <field name="old_move_number"/>
                                     <field name="move_date"/>
                                     <field name="old_account_code"/>
                                     <field name="target_account_id"/>
                                     <field name="partner_id"/>
                                     <field name="tax_id"/>
                                     <field name="source_file"/>
                                     <field name="source_line"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kolac_account_import_batch" model="ir.actions.act_window">
        <field name="name">Lotes de importación contable</field>
        <field name="res_model">kolac.account.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kolac_account_import_batch"
              name="Lotes importación contable"
              parent="account.menu_finance_entries"
              action="action_kolac_account_import_batch"
              sequence="16"
              groups="account.group_account_user"/>
</odoo>
